{
  "DataRefresh": {
    "Enabled": true,
    "CacheDirectory": "App_Data/refresh",
    "Schedules": [
      {
        "Job": "npc-trades",
        "DailyAt": "10:30",
        "TimeZone": "Europe/Vienna",
        "RetryMinutes": 15
      },
      {
        "Job": "market-prices",
        "DailyAt": "10:30",
        "TimeZone": "Europe/Vienna",
        "RetryMinutes": 15
      }
    ]
  },
  "MarketSource": {
    "BaseUrl": "https://api.tibiamarket.top:8001/",
    "WorldsUrl": "https://tibiawiki.dev/api/worlds",
    "AverageBasis": "buy",
    "RequestIntervalSeconds": 6
  },
  "NpcTradeSource": {
    "NpcNames": ["Rashid", "Yasir"],
    "WikiApiUrl": "https://tibia.fandom.com/api.php",
    "TibiaWikiApiUrl": "https://tibiawiki.dev/"
  }
}
